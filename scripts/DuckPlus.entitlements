<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- DuckDB loads extensions (quack, and any the user INSTALLs) as dylibs
       downloaded at runtime, which aren't signed by our team. DuckDB checks
       their own signatures before loading them. -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
